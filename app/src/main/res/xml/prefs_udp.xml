<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">


        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:iconSpaceReserved="false"
            app:key="udp_enabled"
            app:title="Prijímať UDP" />

        <EditTextPreference
            app:defaultValue="5000"
            app:iconSpaceReserved="false"
            app:key="udp_port"
            app:title="UDP port"
            app:useSimpleSummaryProvider="true" />

        <ListPreference
            app:defaultValue="UTF-8"
            app:entries="@array/encoding_entries"
            app:entryValues="@array/encoding_values"
            app:iconSpaceReserved="false"
            app:key="udp_encoding"
            app:title="Kódovanie textu"
            app:useSimpleSummaryProvider="true" />

        <ListPreference
            app:defaultValue="same"
            app:entries="@array/udp_mode_entries"
            app:entryValues="@array/udp_mode_values"
            app:iconSpaceReserved="false"
            app:key="udp_mode"
            app:title="Rozdelenie textu do overlayov"
            app:useSimpleSummaryProvider="true" />

        <EditTextPreference
            app:defaultValue=";"
            app:iconSpaceReserved="false"
            app:key="udp_separator"
            app:title="Oddeľovač (pre režim rozdelenia)"
            app:useSimpleSummaryProvider="true" />

        <EditTextPreference
            app:defaultValue="0"
            app:iconSpaceReserved="false"
            app:key="udp_timeout"
            app:title="Po koľkých sekundách bez správy vrátiť predvolený text (0 = nikdy)"
            app:useSimpleSummaryProvider="true" />

        <EditTextPreference
            app:defaultValue="0"
            app:iconSpaceReserved="false"
            app:key="udp_max_len"
            app:title="Maximálna dĺžka textu (0 = bez obmedzenia)"
            app:useSimpleSummaryProvider="true" />

        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:iconSpaceReserved="false"
            app:key="udp_trim"
            app:summary="Odstrániť medzery a konce riadkov na začiatku a konci"
            app:title="Orezať text" />

        <EditTextPreference
            app:defaultValue=""
            app:iconSpaceReserved="false"
            app:key="udp_multicast"
            app:summary="Nechaj prázdne pre bežný unicast / broadcast (napr. 239.1.1.1)"
            app:title="Multicast skupina (voliteľné)" />

    <PreferenceCategory
        app:iconSpaceReserved="false"
        app:title="Vymazanie textu">

        <ListPreference
            app:defaultValue="hide"
            app:entries="@array/clear_mode_entries"
            app:entryValues="@array/clear_mode_values"
            app:iconSpaceReserved="false"
            app:key="clear_mode"
            app:title="Po vymazaní"
            app:useSimpleSummaryProvider="true" />

        <EditTextPreference
            app:defaultValue="CLEAR"
            app:iconSpaceReserved="false"
            app:key="cmd_clear"
            app:title="UDP príkaz na vymazanie (CLEAR, CLEAR:1 …)"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

    <PreferenceCategory
        app:iconSpaceReserved="false"
        app:title="Automatické vyhľadanie telefónu">

        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:iconSpaceReserved="false"
            app:key="udp_announce"
            app:summary="Telefón každé 2 s ohlási v sieti svoju IP adresu (FSCAM:HELLO) – vysielač, napr. ESP01, ju nemusí poznať vopred"
            app:title="Ohlasovať telefón v sieti" />

        <EditTextPreference
            app:defaultValue="5001"
            app:iconSpaceReserved="false"
            app:key="udp_announce_port"
            app:title="Port, na ktorý sa ohlasuje (počúva na ňom vysielač)"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

    <PreferenceCategory
        app:iconSpaceReserved="false"
        app:title="Časomiera ESP32 (protokol RW:)">

        <SwitchPreferenceCompat
            app:defaultValue="false"
            app:iconSpaceReserved="false"
            app:key="cas_protocol"
            app:summary="Binárny rámec RW: (aj textový $FT) z časomiery ESP32 cez UDP. Ostatné UDP správy a príkazy fungujú ďalej."
            app:title="Prijímať protokol časomiery" />

        <ListPreference
            app:defaultValue="1"
            app:entries="@array/cas_overlay_entries"
            app:entryValues="@array/cas_overlay_values"
            app:iconSpaceReserved="false"
            app:key="cas_lp_overlay"
            app:title="Čas LP (ľavý terč) zobraziť v"
            app:useSimpleSummaryProvider="true" />

        <ListPreference
            app:defaultValue="2"
            app:entries="@array/cas_overlay_entries"
            app:entryValues="@array/cas_overlay_values"
            app:iconSpaceReserved="false"
            app:key="cas_pp_overlay"
            app:title="Čas PP (pravý terč) zobraziť v"
            app:useSimpleSummaryProvider="true" />

        <ListPreference
            app:defaultValue="min"
            app:entries="@array/cas_format_entries"
            app:entryValues="@array/cas_format_values"
            app:iconSpaceReserved="false"
            app:key="cas_format"
            app:title="Formát času"
            app:useSimpleSummaryProvider="true" />

        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:iconSpaceReserved="false"
            app:key="cas_autostart"
            app:summary="Keď časomiera odštartuje (nie odpočet), spustí sa nahrávanie – ako príkaz START"
            app:title="Štart časomiery spustí nahrávanie" />

        <SwitchPreferenceCompat
            app:defaultValue="false"
            app:iconSpaceReserved="false"
            app:key="cas_show_ready"
            app:summary="Vypnuté: po resete časomiery sa čas skryje (podľa „Po vymazaní“), kým neodštartuje"
            app:title="Zobrazovať 0:00:00 aj v pripravenosti" />
    </PreferenceCategory>
</PreferenceScreen>
